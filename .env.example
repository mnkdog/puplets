# Stripe API Keys
# Get these from: https://dashboard.stripe.com/apikeys
# Use test keys for development (starts with pk_test_ and sk_test_)
# Use live keys for production (starts with pk_live_ and sk_live_)

STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# CORS Allowed Origins (REQUIRED)
# Comma-separated list of allowed origins for API requests
# Format: NO SPACES, NO TRAILING COMMAS
# Examples:
#   Production only:
#     ALLOWED_ORIGINS=https://puplets.vercel.app
#   Production + staging:
#     ALLOWED_ORIGINS=https://puplets.vercel.app,https://puplets-staging.vercel.app
#   Production + staging + specific preview:
#     ALLOWED_ORIGINS=https://puplets.vercel.app,https://puplets-staging.vercel.app,https://puplets-git-feature-x.vercel.app
# WARNING: Wildcards on shared multi-tenant domains (.vercel.app, .herokuapp.com, etc.)
# are rejected for security. Use a custom domain with wildcard, or enumerate origins explicitly.
# Malformed or missing ALLOWED_ORIGINS will cause API to return 500 errors.

ALLOWED_ORIGINS=https://puplets.vercel.app,https://puplets-staging.vercel.app,https://puplets-git-feature-x.vercel.app
